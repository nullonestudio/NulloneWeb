# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://nullone.vercel.app

# Google Search Console verification token (content of the google-site-verification meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend — transactional email for the contact form + newsletter.
# If RESEND_API_KEY is unset, submissions are logged server-side and the form still succeeds.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@nullone.vercel.app
CONTACT_FROM_EMAIL="NullOne Website <onboarding@resend.dev>"
